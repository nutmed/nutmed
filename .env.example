# Copie para .env.local (local) ou cadastre em Vercel > Project > Settings > Environment Variables.

# Chave de API pública do RD Station Marketing (Integrações > Chaves de API). Só no servidor.
RD_STATION_API_KEY=

# Container do Google Tag Manager das LPs (ex.: GTM-XXXXXXX).
NEXT_PUBLIC_GTM_ID=

# URL pública do subdomínio (usada em canonical e Open Graph).
NEXT_PUBLIC_SITE_URL=https://materiais.nutmed.com.br

# "false" esconde as marcações "A confirmar" (use em produção).
NEXT_PUBLIC_SHOW_PENDING=false

# Campanhas com data de fim (ex.: Black NutMed) saem do ar sozinhas.
# Para conferir uma versão específica: on (força a campanha) ou off (força a versão fixa). Deixe vazio em produção.
CAMPAIGN_FORCE=
